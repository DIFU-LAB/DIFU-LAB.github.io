// Same three-pillar feedback cycle with compact labels for phone readability.
// Full academic titles are provided in the adjacent accessible HTML.
// Render with neato -n2, preserving the explicit return path and label positions.
digraph SEILResearchLoopMobile {
  graph [layout=neato, splines=true, bgcolor="white", pad=0.18, margin=0, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#F7F8FA", color="#D9DFE8", penwidth=1.2, fixedsize=true, width=4.6, height=1.55, margin="0.15,0.15", fontname="DejaVu Sans"];
  edge [color="#8B1A1A", penwidth=2.4, arrowsize=0.9, fontname="DejaVu Sans", fontsize=15, fontcolor="#8B1A1A"];
  cognition [pos="230,560!", label=<<FONT POINT-SIZE="12" COLOR="#8B1A1A">01 · HUMAN MECHANISMS</FONT><BR/><BR/><FONT POINT-SIZE="22" COLOR="#1B2A4A"><B>Human Social Cognition</B></FONT><BR/><BR/><FONT POINT-SIZE="14" COLOR="#4A5568">Social attention · Crossmodal integration</FONT>>];
  modelling [pos="230,340!", label=<<FONT POINT-SIZE="12" COLOR="#8B1A1A">02 · COMPUTATIONAL MODELS</FONT><BR/><BR/><FONT POINT-SIZE="21" COLOR="#1B2A4A"><B>Computational</B><BR/><B>Modelling &amp; AI</B></FONT><BR/><BR/><FONT POINT-SIZE="14" COLOR="#4A5568">Human-inspired models and learning</FONT>>];
  interaction [pos="230,120!", label=<<FONT POINT-SIZE="12" COLOR="#8B1A1A">03 · INTERACTIVE EVALUATION</FONT><BR/><BR/><FONT POINT-SIZE="22" COLOR="#1B2A4A"><B>Simulation &amp; Interaction</B></FONT><BR/><BR/><FONT POINT-SIZE="14" COLOR="#4A5568">Robotic simulation · Human-robot cooperation<BR/>Human-AI interaction</FONT>>];
  cognition:s -> modelling:n [pos="e,230,395.8 230,504.2 230,485 230,430 230,405.8"];
  modelling:s -> interaction:n [pos="e,230,175.8 230,284.2 230,265 230,210 230,185.8"];
  interaction:w -> cognition:w [pos="e,64.4,560 64.4,120 9,120 9,120 9,340 9,560 9,560 54.4,560"];
  empirical_label [shape=box, fixedsize=false, style=filled, fillcolor=white, color=white, width=0, height=0, margin="0.08,0.06", pos="230,450!", fontcolor="#8B1A1A", fontsize=15, label="Empirical constraints"];
  models_label [shape=box, fixedsize=false, style=filled, fillcolor=white, color=white, width=0, height=0, margin="0.08,0.06", pos="230,230!", fontcolor="#8B1A1A", fontsize=15, label="Testable models & behaviours"];
  feedback [shape=plaintext, style="", fixedsize=false, width=0, height=0, pos="220,22!", label=<<FONT POINT-SIZE="15" COLOR="#8B1A1A"><B>Evidence &amp; new hypotheses</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#64748B">feed back into cognition and model design</FONT>>];
}
